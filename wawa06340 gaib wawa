import React, { useState } from 'react';
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog";

// Liste des produits avec leurs goûts et images
const products = [
  {
    id: 1,
    name: "Puff El Fakher Pastèque Glacée",
    price: 22.50,
    image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/pastèque.jpg",
    description: "Un goût rafraîchissant de pastèque glacée, signé El Fakher.",
    category: "top",
    brand: "El Fakher",
    flavors: [
      { name: "Pastèque Glacée", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/pastèque.jpg" },
      { name: "Pêche", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/peche.jpg" },
      { name: "Citron Menthe", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/citron-menthe.jpg" }
    ],
    isNew: true
  },
  {
    id: 2,
    name: "Starbuzz Blue Mist Puff",
    price: 22.50,
    image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/blue-mist.jpg",
    description: "Le classique Blue Mist de Starbuzz en version puff.",
    category: "top",
    brand: "Starbuzz",
    flavors: [
      { name: "Blue Mist", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/blue-mist.jpg" },
      { name: "Pink Lemonade", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/pink-lemonade.jpg" },
      { name: "Code 69", image: "https://vapelite-images.s3.eu-west-3.amazonaws.com/code69.jpg" }
    ],
    isNew: false
  }
];

// Composant principal pour la page d'accueil
export default function HomePage() {
  const [cart, setCart] = useState([]);
  const [selectedFlavor, setSelectedFlavor] = useState({});

  // Fonction pour ajouter un produit au panier
  const addToCart = (product, flavor) => {
    const selected = flavor || selectedFlavor[product.id] || product.flavors[0].name;
    setCart([...cart, { ...product, selectedFlavor: selected }]);
  };

  // Calcul du total du panier
  const total = cart.reduce((sum, item) => sum + item.price, 0).toFixed(2);

  // Fonction pour afficher les produits dans une catégorie donnée
  const renderCategory = (title, filter) => (
    <section className="mb-10">
      <h2 className="text-2xl font-semibold text-gray-800 mb-4">{title}</h2>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        {products.filter(filter).map((product) => (
          <Dialog key={product.id}>
            <DialogTrigger asChild>
              <div className="border rounded-2xl shadow p-4 cursor-pointer hover:shadow-lg transition">
                <img src={product.image} alt={product.name} className="w-full h-64 object-cover rounded-xl mb-4" />
                <h3 className="text-xl font-semibold text-gray-800">{product.name}</h3>
                <p className="text-gray-600 mb-2">{product.description}</p>
                <p className="font-bold text-blue-600">{product.price.toFixed(2)}€</p>
              </div>
            </DialogTrigger>
            <DialogContent className="max-w-xl">
              <DialogHeader>
                <DialogTitle>{product.name}</DialogTitle>
              </DialogHeader>
              <p className="text-gray-700 mb-4">{product.description}</p>
              <div className="grid grid-cols-3 gap-4 mb-4">
                {product.flavors.map((flavor, idx) => (
                  <div
                    key={idx}
                    className="border rounded-xl p-2 text-center cursor-pointer hover:bg-blue-100"
                    onClick={() => addToCart(product, flavor.name)}
                  >
                    <img src={flavor.image} alt={flavor.name} className="h-24 w-full object-cover rounded-md mb-1" />
                    <span className="text-sm font-medium text-gray-800">{flavor.name}</span>
                  </div>
                ))}
              </div>
              <Button onClick={() => addToCart(product)} className="w-full mt-2">Ajouter au panier</Button>
            </DialogContent>
          </Dialog>
        ))}
      </div>
    </section>
  );

  return (
    <div className="p-6 max-w-6xl mx-auto">
      {/* Header avec message de bienvenue et avertissement */}
      <header className="mb-10 text-center">
        <h1 className="text-4xl font-bold text-blue-800">VapElite</h1>
        <p className="mt-4 text-gray-700 max-w-2xl mx-auto">
          🔒 Qualité, Fiabilité, Sécurité — Chez <strong>VapElite</strong>, nous proposons uniquement des produits premium certifiés.<br/>
          ⚠️ Produit interdit aux mineurs. Contient de la nicotine, une substance addictive.
        </p>
      </header>

      {/* Sections des produits */}
      {renderCategory("🔥 Top 5 des Meilleures Puffs", p => p.category === "top")}
      {renderCategory("🆕 Nouveautés", p => p.category === "nouveautes" || p.isNew)}
      {renderCategory("⚡ Prix Flash", p => p.category === "deals")}

      {/* Panier et options de paiement */}
      <aside className="border-t pt-4 mt-10">
        <h2 className="text-2xl font-semibold mb-2">🛒 Panier</h2>
        {cart.length === 0 ? (
          <p className="text-gray-500">Votre panier est vide.</p>
        ) : (
          <div>
            <ul className="space-y-1 mb-2">
              {cart.map((item, idx) => (
                <li key={idx} className="text-gray-800">
                  • {item.name} ({item.selectedFlavor}) - {item.price.toFixed(2)}€
                </li>
              ))}
            </ul>
            <p className="font-bold text-right">Total : {total}€</p>
            <Button className="mt-2 w-full bg-green-600 hover:bg-green-700">Payer avec PayPal / Crypto</Button>
          </div>
        )}
      </aside>

      {/* Mention légale */}
      <footer className="mt-10 text-center text-sm text-gray-500">
        ⚠️ Produit interdit aux mineurs. Contient de la nicotine, une substance addictive.
      </footer>
    </div>
  );
}
